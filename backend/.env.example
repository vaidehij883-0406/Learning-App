# LearnBatch Backend Environment Variables
PROJECT_NAME="LearnBatch API"
API_V1_STR="/api/v1"

# Security (Replace with strong random key in production)
SECRET_KEY="replace-with-a-very-long-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For Local SQLite:
DATABASE_URL="sqlite:///./learnbatch.db"
# For Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth & Storage Integration (Optional for local standalone mode)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-ANON-PUBLIC-KEY]"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# Storage Engine ("local" or "supabase")
STORAGE_BACKEND="local"
BASE_URL="http://localhost:8000"
